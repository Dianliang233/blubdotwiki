    "deploy": "npm run typecheck && npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@cloudflare/workers-types": "^5.20261125.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.168.0"
  }
}
