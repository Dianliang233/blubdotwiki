{
  "name": "blubdotwiki",
  "version": "1.0.0",
  "packageManager": "pnpm@12.21.0",
  "private": true,
  "scripts": {
    "build": "eleventy",
    "dev": "eleventy --serve",
    "dev:wrangler": "npm run build && wrangler dev --local",
