<!doctype html>
<html lang="{{ locale.code }}" dir="{{ locale.dir }}">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{{ locale.strings.blub | escape }}</title>
    <meta
      name="description"
      content="{{ locale.strings.description | escape }}"
    />

    <link rel="canonical" href="{{ locale.url }}" />
    {% for l in locales %}
    <link rel="alternate" hreflang="{{ l.code }}" href="{{ l.url }}" />
    {% endfor %}
    <link rel="alternate" hreflang="x-default" href="{{ locales.first.url }}" />

    <link rel="icon" type="image/png" href="/blubpics/blubby" />

    <meta property="og:title" content="{{ locale.strings.blub | escape }}" />
    <meta
      property="og:description"
      content="{{ locale.strings.description | escape }}"
    />
    <meta property="og:url" content="{{ locale.url }}" />
    <meta property="og:image" content="{{ locale.url }}blubpics/blubby" />

    <script id="discord:component-embed" type="application/json">
      {
        "component": {
          "type": 17,
          "accent_color": 8438000,
          "components": [
            {
              "type": 9,
              "components": [
                {
                  "type": 10,
                  "content": {{ locale.discordHeading | jsonify }}
                },
                {
                  "type": 10,
                  "content": {{ locale.strings.discordDescription | replace: '{blubChain}', locale.blubChain | jsonify }}
                }
              ],
              "accessory": {
                "type": 11,
                "media": {
                  "url": "{{ locale.url }}blubpics/plush"
                }
              }
            },
            {
              "type": 14,
              "divider": true,
              "spacing": 1
            },
            {
              "type": 10,
              "content": {{ locale.strings.discordFooter | jsonify }}
            }
          ]
        }
      }
    </script>
    <style>
      html,
      body {
        touch-action: manipulation;
      }

      @keyframes blink {
        0%,
        75% {
          opacity: 1;
        }
        76%,
        100% {
          opacity: 0;
        }
      }

      .blink {
        animation: blink 500ms ease-in infinite alternate;
      }

      #blubsprite {
        transform-origin: 50% 100%;
        transition: transform 240ms cubic-bezier(0.34, 1.56, 0.64, 1);
      }

      body.holding #blubsprite {
        transform: scale(0.84, 0.76);
        transition-duration: 80ms;
        transition-timing-function: ease-out;
      }

      body {
        cursor: grab;
      }

      body.holding {
        cursor: grabbing;
      }

      .blub-button {
        padding: 6px 12px;
        color: #000;
        font: inherit;
        font-size: 14px;
        background: #e8f7ff;
        border: 2px solid #000;
        border-radius: 3px;
        box-shadow: 3px 3px 0 #000;
        cursor: pointer;
        touch-action: manipulation;
      }

      .blub-button:hover {
        background: #fff;
      }

      .blub-button:active {
        box-shadow: 1px 1px 0 #000;
        transform: translate(2px, 2px);
      }

      .blub-button:focus-visible {
        outline: 3px solid #fff;
        outline-offset: 2px;
      }

      .marquee {
        width: 100%;
        overflow: hidden;
        color: #000;
        font-size: 32px;
        white-space: nowrap;
      }

      .marquee-track {
        display: flex;
        width: max-content;
        animation: marquee-scroll 40s linear infinite;
      }

      .marquee--right .marquee-track {
        animation-direction: reverse;
      }

      .marquee-track span {
        display: block;
        padding-right: 0.5em;
      }

      @keyframes marquee-scroll {
        from {
          transform: translateX(0);
        }
        to {
          transform: translateX(-50%);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation: none !important;
          transition: none !important;
          scroll-behavior: auto !important;
        }
      }
    </style>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      overflow: hidden;
      color: #000;
      background-color: #80c0f0;
      height: 100vh;
      font-family: 'Comic Sans MS', sans-serif;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      user-select: none;
    "
  >
    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        <span>{{ locale.marquee }}</span>
        <span>{{ locale.marquee }}</span>
      </div>
    </div>
    <div
      style="
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        flex: 1;
        text-align: center;
        padding-inline: 32px;
      "
    >
      <div style="position: relative">
        <img
          id="blubsprite"
          alt="{{ locale.strings.alt | replace: '{skin}', locale.strings.skinNames.soulEngorged | escape }}"
          width="128"
          height="128"
          style="
            width: max(128px, 10vw);
            height: max(128px, 10vw);
            pointer-events: none;
          "
          src="https://minecraft.wiki/images/thumb/MCD2_Blub_Render.png/256px-MCD2_Blub_Render.png"
        />
        <div
          style="
            position: absolute;
            top: -10px;
            right: -10px;
            transform: rotate(-10deg);
          "
        >
          <span id="blubcount">0</span>x
        </div>
      </div>
      <div style="text-wrap: balance">
        <div style="font-size: max(32px, 4vw)">
          {{ locale.strings.heading }}<span class="blink">...</span>
        </div>
        <div style="font-size: max(16px, 2vw)">
          {{ locale.strings.subtitle }}
        </div>
      </div>
    </div>

    <div
      style="
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-inline: 32px;
        padding-bottom: 4px;
        text-align: center;
      "
    >
        <div
          style="
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            justify-content: center;
          "
        >
          <button id="skin-button" class="blub-button" type="button">
            {{ locale.strings.skin }}: {{ locale.strings.skinNames.soulEngorged }}
          </button>
          <button
            id="sound-button"
            class="blub-button"
            type="button"
            aria-pressed="true"
          >
            {{ locale.strings.sound }}: {{ locale.strings.on }}
          </button>
        </div>
        <nav
          aria-label="Language"
          style="font-size: 12px; margin-top: 6px; opacity: 0.75"
        >
          {% for l in locales %}{% if l.code == locale.code %}<strong>{{ l.label }}</strong>{% else %}<a
            href="{{ l.url }}"
            hreflang="{{ l.code }}"
            lang="{{ l.code }}"
            style="color: inherit"
            >{{ l.label }}</a
          >{% endif %}{% unless forloop.last %} <span aria-hidden="true">·</span> {% endunless %}{% endfor %}
        </nav>
    </div>

    <div class="marquee marquee--right" aria-hidden="true">
      <div class="marquee-track">
        <span>{{ locale.marquee }}</span>
        <span>{{ locale.marquee }}</span>
      </div>
    </div>

    <script>
      const REDIRECT_URL = '{{ locale.wikiUrl }}'
      const STRINGS = {{ locale.strings | jsonify }}

      const wikiThumb = (file) =>
        `https://minecraft.wiki/images/thumb/${file}/256px-${file}`

      const SKINS = [
        {
          name: {{ locale.strings.skinNames.soulEngorged | jsonify }},
          image: wikiThumb('MCD2_Blub_Render.png'),
          sound: 'jellyBunny',
        },
        {
          name: {{ locale.strings.skinNames.carapace | jsonify }},
          image: wikiThumb('MCD2_Blub_Carapace_Render.png'),
          sound: 'jellyBunnyCarapace',
        },
        {
          name: {{ locale.strings.skinNames.meadows | jsonify }},
          image: wikiThumb('MCD2_Blub_Meadows_Render.png'),
          sound: 'jellyBunnyMeadow',
        },
        {
          name: {{ locale.strings.skinNames.fungal | jsonify }},
          image: wikiThumb('MCD2_Blub_Fungal_Render.png'),
          sound: 'jellyBunny',
        },
        {
          name: {{ locale.strings.skinNames.ravines | jsonify }},
          image: wikiThumb('MCD2_Blub_Ravines_Render.png'),
          sound: 'jellyBunnyRavine',
        },
      ]

      const blubSprite = document.getElementById('blubsprite')
      const blubCount = document.getElementById('blubcount')
      const skinButton = document.getElementById('skin-button')
      const soundButton = document.getElementById('sound-button')
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)')

      const soundCache = new Map()
      const storedSkin = Number(localStorage.getItem('blubskin'))
      let skinIndex = SKINS[storedSkin] ? storedSkin : 0
      let soundOn = localStorage.getItem('blubsound') !== 'off'

      function getAudio(url) {
        if (!soundCache.has(url)) {
          const audio = new Audio(url)
          audio.preload = 'auto'
          soundCache.set(url, audio)
        }

        return soundCache.get(url)
      }

      function skinSounds(skin) {
        return [1, 2, 3, 4, 5].map((n) => {
          const file = `Mob_passive_${skin.sound}_idle_00${n}_%28SFX%29.ogg`
          return `https://minecraft.wiki/images/transcoded/${file}/${file}.mp3`
        })
      }

      function playSound() {
        if (!soundOn) return

        const sounds = skinSounds(SKINS[skinIndex])
        const audio = getAudio(
          sounds[Math.floor(Math.random() * sounds.length)],
        )
        audio.currentTime = 0
        audio.play().catch(() => {})
      }

      function applySkin() {
        const skin = SKINS[skinIndex]
        blubSprite.src = skin.image
        blubSprite.alt = STRINGS.alt.replace('{skin}', skin.name)
        skinButton.textContent = `${STRINGS.skin}: ${skin.name}`
        skinButton.setAttribute(
          'aria-label',
          STRINGS.changeSkin.replace('{skin}', skin.name),
        )
        skinSounds(skin).forEach(getAudio)
      }

      function applySound() {
        soundButton.textContent = `${STRINGS.sound}: ${
          soundOn ? STRINGS.on : STRINGS.off
        }`
        soundButton.setAttribute('aria-pressed', String(soundOn))
      }

      applySkin()
      applySound()

      let redirectTimeout
      let releaseTimeout
      let pressStartedAt = 0
      let pressed = false

      function isProd() {
        return (
          location.hostname === 'blub.wiki' ||
          location.hostname.endsWith('.blub.wiki')
        )
      }

      if (document.cookie.includes('blubstreak=')) {
        // read the host only and the shared cookie, add them together, and write the shared cookie
        const cookies = document.cookie.match(
          /(?:^|;\s*)blubstreak=(\d+)/g,
        )
        if (cookies) {
          const total = cookies.reduce(
            (sum, cookie) => sum + Number(cookie.split('=')[1]),
            0,
          )
          writePetCount(total)
        }

        if (isProd()) {
          document.cookie = "blubstreak=; path=/; expires=Thu, 01 Jan 1970 00:00:01 GMT";
        }
      }

      function readPetCount() {
        const cookie = document.cookie.match(
          /(?:^|;\s*)blubstreak=(\d+)/,
        )

        return cookie ? Number(cookie[1]) : 0
      }

      function writePetCount(count) {
        const domain = isProd() ? '; domain=.blub.wiki' : ''
        const secure = location.protocol === 'https:' ? '; secure' : ''
        document.cookie = `blubstreak=${count}; path=/; max-age=63158400; samesite=lax${domain}${secure}`
      }

      let petCount = readPetCount()

      // migrate from localStorage
      if (localStorage.getItem('blubstreak')) {
        petCount += Number(localStorage.getItem('blubstreak'))
        writePetCount(petCount)
        localStorage.removeItem('blubstreak')
      }

      blubCount.textContent = petCount

      window.addEventListener('focus', () => {
        const shared = readPetCount()
        if (shared !== petCount) {
          petCount = shared
          blubCount.textContent = petCount
        }
      })

      function scheduleRedirect(delay) {
        clearTimeout(redirectTimeout)
        redirectTimeout = setTimeout(() => {
          location.href = REDIRECT_URL
        }, delay)
      }

      if (!/bot|crawler|spider|crawling/i.test(navigator.userAgent)) {
        scheduleRedirect(2500)
      }

      function releaseBlub() {
        if (!pressed) return

        pressed = false
        const remaining = 80 - (performance.now() - pressStartedAt)
        releaseTimeout = setTimeout(
          () => {
            document.body.classList.remove('holding')
            scheduleRedirect(2000)
          },
          Math.max(0, remaining),
        )
      }

      document.body.addEventListener('mousedown', (event) => {
        clearTimeout(redirectTimeout)
        clearTimeout(releaseTimeout)
        pressStartedAt = performance.now()
        pressed = true

        if (event.target.closest('button, a')) return

        document.body.classList.add('holding')

        petCount += 1
        blubCount.textContent = petCount
        writePetCount(petCount)

        playSound()
      })

      skinButton.addEventListener('click', () => {
        skinIndex = (skinIndex + 1) % SKINS.length
        localStorage.setItem('blubskin', skinIndex)
        applySkin()
        playSound()
      })

      soundButton.addEventListener('click', () => {
        soundOn = !soundOn
        localStorage.setItem('blubsound', soundOn ? 'on' : 'off')

        if (!soundOn) {
          soundCache.forEach((audio) => audio.pause())
        }

        applySound()
        playSound()
      })

      window.addEventListener('mouseup', releaseBlub)
      window.addEventListener('blur', releaseBlub)
    </script>
  </body>
</html>
